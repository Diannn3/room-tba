---
export const prerender = true;
import Layout from "@layouts/Layout.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<Layout
  title="Transparency | Room TBA"
  description="Monthly money report for Room TBA and UPLB Tools: every donation in, every expense out, with receipts."
  canonicalPath="/transparency"
  showAppLoadingShell={false}
>
  <main class="transparency-page">
    <a href="/" class="back-link">
      <span aria-hidden="true">←</span> Back to Room TBA
    </a>

    <header class="hero">
      <h1>Transparency report</h1>
      <p class="lede">
        Room TBA runs on donations. This page lists every peso in and every
        peso out, month by month, with receipts. Sponsorships follow the
        40/30/30 split on the <a href="/sponsors">sponsors page</a>. There
        were no sponsors this period, so everything here is donations.
      </p>
    </header>

    <section class="month" aria-labelledby="jul-aug-2026">
      <h2 id="jul-aug-2026">July to August 2026</h2>

      <div class="summary">
        <div class="summary-item">
          <span class="summary-label">Income</span>
          <span class="summary-value">₱1,790.35</span>
        </div>
        <div class="summary-item">
          <span class="summary-label">Expenses</span>
          <span class="summary-value">₱5,985.03</span>
        </div>
        <div class="summary-item summary-net">
          <span class="summary-label">Net</span>
          <span class="summary-value">−₱4,194.68</span>
        </div>
      </div>

      <h3>Money in</h3>
      <ul class="ledger">
        <li class="ledger-month">August</li>
        <li>
          <div class="ledger-what">
            13 donations through <a href="/donate">/donate</a>, Aug 3 to 9,
            after PayMongo fees
          </div>
          <div class="ledger-amount">₱1,290.35</div>
        </li>
        <li>
          <div class="ledger-what">
            Donation from the UPLB Student Help Desk, sent by GCash
          </div>
          <div class="ledger-amount">₱500.00</div>
        </li>
        <li class="ledger-total">
          <div class="ledger-what">Total in</div>
          <div class="ledger-amount">₱1,790.35</div>
        </li>
      </ul>

      <h3>Money out</h3>
      <p class="ledger-intro">
        Grouped by month paid, recurring costs first.
      </p>
      <ul class="ledger">
        <li class="ledger-month">July</li>
        <li>
          <div class="ledger-what">
            uplb.tools domain, paid Jul 13 <span class="recur">yearly</span>
            (<a href="/transparency/2026-07-porkbun-domain.png">receipt</a>)
          </div>
          <div class="ledger-amount">₱618.16 ($9.78)</div>
        </li>
        <li class="ledger-month">August</li>
        <li>
          <div class="ledger-what">
            Vercel Pro hosting, July cycle, paid Aug 2 <span class="recur">monthly</span>
            (<a href="/transparency/2026-08-vercel-pro.png">receipt</a>)
          </div>
          <div class="ledger-amount">₱1,264.14 ($20.00)</div>
        </li>
        <li>
          <div class="ledger-what">
            Vercel platform and usage, invoice 67F77D49-0006, issued Aug 22
            <span class="recur">monthly, usage varies</span>
            <ul class="sublines">
              <li>Pro seat ₱1,264.14 ($20.00)</li>
              <li>Build minutes ₱836.86 ($13.24)</li>
              <li>Observability ₱324.25 ($5.13)</li>
              <li>Serverless compute ₱185.83 ($2.94)</li>
              <li>Bandwidth ₱67.63 ($1.07)</li>
              <li>Web analytics ₱53.09 ($0.84)</li>
              <li>Functions and image tools ₱48.04 ($0.76)</li>
            </ul>
          </div>
          <div class="ledger-amount">₱2,779.84 ($43.98)</div>
        </li>
        <li>
          <div class="ledger-what">
            OpenCode Go subscription for maintenance tooling, paid Aug 10
            <span class="recur">monthly</span>
            (<a href="/transparency/2026-08-opencode-go.png">receipt</a>)
          </div>
          <div class="ledger-amount">₱316.03 ($5.00)</div>
        </li>
        <li>
          <div class="ledger-what">
            Meta ads promoting Room TBA, six charges Aug 3 to 31, ₱898.98
            ad spend plus 12% VAT <span class="recur">one-time</span>
            (<a href="/transparency/2026-08-meta-ads.png">receipt</a>)
          </div>
          <div class="ledger-amount">₱1,006.86</div>
        </li>
        <li class="ledger-total">
          <div class="ledger-what">Total out</div>
          <div class="ledger-amount">₱5,985.03</div>
        </li>
      </ul>

      <h3>Liabilities</h3>
      <p class="ledger-intro">
        Every expense above was paid from the maintainer's personal card. What
        donations did not cover, the project owes back.
      </p>
      <ul class="ledger">
        <li>
          <div class="ledger-what">
            Owed to the maintainer, expenses of ₱5,985.03 less ₱1,790.35 in
            donations received
          </div>
          <div class="ledger-amount">₱4,194.68</div>
        </li>
        <li>
          <div class="ledger-what">
            Waived by the maintainer as a personal donation
          </div>
          <div class="ledger-amount">−₱500.00</div>
        </li>
        <li class="ledger-total">
          <div class="ledger-what">Balance owed</div>
          <div class="ledger-amount">₱3,694.68</div>
        </li>
      </ul>

      <h3>Receipts</h3>
      <div class="receipts">
        <figure>
          <a href="/transparency/2026-08-vercel-pro.png">
            <img
              src="/transparency/2026-08-vercel-pro.png"
              alt="Vercel invoice 67F77D49-0004, July 2026 Pro plan, $20.00, paid August 2, 2026"
              loading="lazy"
              width="751"
              height="545"
            />
          </a>
          <figcaption>Vercel Pro, invoice 67F77D49-0004</figcaption>
        </figure>
        <figure>
          <a href="/transparency/2026-07-porkbun-domain.png">
            <img
              src="/transparency/2026-07-porkbun-domain.png"
              alt="Porkbun invoice 10981073, uplb.tools domain registration, $9.78, buyer details redacted"
              loading="lazy"
              width="850"
              height="390"
            />
          </a>
          <figcaption>uplb.tools domain, Porkbun invoice 10981073</figcaption>
        </figure>
        <figure>
          <a href="/transparency/2026-08-meta-ads.png">
            <img
              src="/transparency/2026-08-meta-ads.png"
              alt="Meta billing report for July to September 2026, six ad payments totaling PHP 1,006.86, all paid, account and card details redacted"
              loading="lazy"
              width="756"
              height="612"
            />
          </a>
          <figcaption>Meta ads, billing report Jul 1 to Sep 1</figcaption>
        </figure>
        <figure>
          <a href="/transparency/2026-08-opencode-go.png">
            <img
              src="/transparency/2026-08-opencode-go.png"
              alt="Stripe receipt 2138-9554 from Anomaly, OpenCode Go, $5.00, charged ₱316.03 at 63.2069 PHP per USD"
              loading="lazy"
              width="405"
              height="680"
            />
          </a>
          <figcaption>OpenCode Go, Stripe receipt 2138-9554</figcaption>
        </figure>
      </div>
      <p class="receipt-note">Buyer names and addresses are redacted.</p>

      <h3>Notes</h3>
      <p>
        Donations covered ₱1,790.35 of the period's ₱5,985.03 in costs. The
        maintainer paid the rest personally and waived ₱500.00 of it as a
        donation, leaving the balance under Liabilities. Future donations
        repay that balance before anything else, then follow the 40/30/30
        split. All 13 site donations came in during
        enlistment week (Aug 3 to 9) and none after. Donations follow campus
        foot traffic.
      </p>
      <p>
        The OpenCode receipt shows the real card charge of ₱316.03 at 63.2069
        pesos per dollar. The Vercel and Porkbun peso figures use that same
        rate, since all three were paid on the same card in the same period.
        This first report runs from July 18, when donations opened, through
        the end of August. From September on, each report covers the invoices
        and charges dated that month.
      </p>
      <p>
        The ads ran during enlistment week. Pageviews went from 15,430 the
        week before to 30,346 (Vercel Analytics), and all 13 donations came
        in that week, ₱1,290.35 against ₱1,006.86 in ad cost. Enlistment
        raises traffic by itself, so not all of that was the ads. The three
        campaigns drew 755 link clicks (₱0.69 per click on the main one, with
        an 8.2% click-through rate) and 469 post engagements. Reach is
        also how other campuses find the project. Room TBA is built to be
        forked, and forks for
        <a href="https://github.com/andrianllmm/upv-room-tba">UP Visayas</a>,
        <a href="https://github.com/UPB-Tools/room-tba">UP Baguio</a>, and
        Bulacan State University are already active. The BulSU fork is live
        at <a href="https://bulsu-room-tba.vercel.app">bulsu-room-tba.vercel.app</a>.
      </p>
      <p>
        The ₱2,779.84 Vercel invoice is a peak, not the usual bill. Its usage
        charges came from the same enlistment surge. In a quiet month usage
        fits inside the plan's included credit and the bill is just the
        ₱1,264.14 seat, which is where the current cycle is tracking so far.
      </p>
      <figure class="chart">
        <figcaption>Daily page views, Jul 27 to Aug 10. Ads started Aug 3.</figcaption>
        <svg viewBox="0 0 640 150" role="img" aria-label="Line chart of daily page views. Baseline around 1,500 a day, peak 10,068 on Aug 4 after ads started Aug 3, back near 1,000 by Aug 6.">
          <line x1="46" y1="128" x2="634" y2="128" stroke="#e8e2e1" />
          <line x1="46" y1="70.9" x2="634" y2="70.9" stroke="#e8e2e1" />
          <line x1="46" y1="13.7" x2="634" y2="13.7" stroke="#e8e2e1" />
          <text x="42" y="131" class="tick" text-anchor="end">0</text>
          <text x="42" y="74" class="tick" text-anchor="end">5k</text>
          <text x="42" y="17" class="tick" text-anchor="end">10k</text>
          <line x1="340" y1="10" x2="340" y2="128" stroke="#8a8a8a" stroke-dasharray="3 3" />
          <text x="336" y="20" class="tick" text-anchor="end">ads start</text>
          <path d="M46,128.0 L46.0,91.1 L88.0,105.2 L130.0,108.0 L172.0,112.1 L214.0,114.2 L256.0,111.2 L298.0,95.5 L340.0,36.8 L382.0,12.9 L424.0,57.3 L466.0,118.1 L508.0,116.9 L550.0,116.6 L592.0,123.1 L634.0,120.4 L634.0,128.0 Z" fill="#A63D33" opacity="0.12" />
          <polyline points="46.0,91.1 88.0,105.2 130.0,108.0 172.0,112.1 214.0,114.2 256.0,111.2 298.0,95.5 340.0,36.8 382.0,12.9 424.0,57.3 466.0,118.1 508.0,116.9 550.0,116.6 592.0,123.1 634.0,120.4" fill="none" stroke="#A63D33" stroke-width="2" />
          <circle cx="382" cy="12.9" r="3.5" fill="#A63D33" />
          <text x="374" y="11" class="dlabel" text-anchor="end">10,068</text>
          <text x="46" y="145" class="tick">Jul 27</text>
          <text x="256" y="145" class="tick" text-anchor="middle">Aug 1</text>
          <text x="340" y="145" class="tick" text-anchor="middle">3</text>
          <text x="424" y="145" class="tick" text-anchor="middle">5</text>
          <text x="508" y="145" class="tick" text-anchor="middle">7</text>
          <text x="634" y="145" class="tick" text-anchor="end">10</text>
        </svg>
      </figure>

      <figure class="chart">
        <figcaption>Donations per day, net of fees. All 13 landed Aug 3 to 9.</figcaption>
        <svg viewBox="0 0 640 150" role="img" aria-label="Bar chart of daily donations. Aug 3 peak of 591 pesos, tapering to about 49 pesos by Aug 9, nothing outside Aug 3 to 9.">
          <line x1="46" y1="128" x2="634" y2="128" stroke="#e8e2e1" />
          <line x1="46" y1="72.6" x2="634" y2="72.6" stroke="#e8e2e1" />
          <line x1="46" y1="17.2" x2="634" y2="17.2" stroke="#e8e2e1" />
          <text x="42" y="131" class="tick" text-anchor="end">0</text>
          <text x="42" y="76" class="tick" text-anchor="end">300</text>
          <text x="42" y="21" class="tick" text-anchor="end">600</text>
          <rect x="331" y="18.9" width="18" height="109.1" rx="3" fill="#2F6BB0"><title>Aug 3, ₱591.00</title></rect>
          <rect x="373" y="82.5" width="18" height="45.5" rx="3" fill="#2F6BB0"><title>Aug 4, ₱246.25</title></rect>
          <rect x="415" y="118.9" width="18" height="9.1" rx="3" fill="#2F6BB0"><title>Aug 5, ₱49.25</title></rect>
          <rect x="457" y="124.4" width="18" height="3.6" rx="2" fill="#2F6BB0"><title>Aug 6, ₱19.70</title></rect>
          <rect x="499" y="111.6" width="18" height="16.4" rx="3" fill="#2F6BB0"><title>Aug 7, ₱88.65</title></rect>
          <rect x="541" y="82.5" width="18" height="45.5" rx="3" fill="#2F6BB0"><title>Aug 8, ₱246.25</title></rect>
          <rect x="583" y="118.9" width="18" height="9.1" rx="3" fill="#2F6BB0"><title>Aug 9, ₱49.25</title></rect>
          <text x="340" y="14" class="dlabel" text-anchor="middle">₱591</text>
          <text x="46" y="145" class="tick">Jul 27</text>
          <text x="256" y="145" class="tick" text-anchor="middle">Aug 1</text>
          <text x="340" y="145" class="tick" text-anchor="middle">3</text>
          <text x="424" y="145" class="tick" text-anchor="middle">5</text>
          <text x="508" y="145" class="tick" text-anchor="middle">7</text>
          <text x="634" y="145" class="tick" text-anchor="end">10</text>
        </svg>
      </figure>

      <figure class="chart chart-narrow">
        <figcaption>The peak Vercel invoice against a quiet month.</figcaption>
        <svg viewBox="0 0 640 170" role="img" aria-label="Stacked bar chart. The July cycle invoice is 2,779.84 pesos, a 1,264.14 peso seat plus 1,515.70 pesos of surge usage. A quiet month is the seat alone.">
          <line x1="46" y1="146" x2="634" y2="146" stroke="#e8e2e1" />
          <line x1="46" y1="98.4" x2="634" y2="98.4" stroke="#e8e2e1" />
          <line x1="46" y1="50.8" x2="634" y2="50.8" stroke="#e8e2e1" />
          <text x="42" y="149" class="tick" text-anchor="end">0</text>
          <text x="42" y="102" class="tick" text-anchor="end">1k</text>
          <text x="42" y="54" class="tick" text-anchor="end">2k</text>
          <rect x="150" y="85.8" width="90" height="60.2" rx="3" fill="#A63D33"><title>Pro seat, ₱1,264.14</title></rect>
          <rect x="150" y="13.7" width="90" height="70.1" rx="3" fill="#2F6BB0"><title>Usage from the surge, ₱1,515.70</title></rect>
          <text x="250" y="55" class="dlabel">usage ₱1,515.70</text>
          <text x="250" y="120" class="dlabel">seat ₱1,264.14</text>
          <text x="150" y="164" class="tick">July cycle invoice, ₱2,779.84</text>
          <rect x="420" y="85.8" width="90" height="60.2" rx="3" fill="#A63D33"><title>Pro seat, ₱1,264.14</title></rect>
          <text x="520" y="120" class="dlabel">seat ₱1,264.14</text>
          <text x="420" y="164" class="tick">Quiet month, ₱1,264.14</text>
        </svg>
      </figure>

      <p>
        No contributor payouts this month. Income was below the operating
        floor, so everything went to operations.
      </p>

      <h3>Updates</h3>
      <p>
        AMIS is in a data cleaning phase and Room TBA is helping with it. Ken
        and Eunice, the DX-AMIS student assistants, are working on the
        cleanup.
      </p>
    </section>

    <section class="donate-line">
      <p>
        If Room TBA is useful to you, <a href="/donate">a donation</a> covers
        next month's bill.
      </p>
    </section>

    <SiteFooter />
  </main>
</Layout>

<style>
  /* Hallmark · macrostructure: ledger document · theme: house (Raleway · maroon · light paper) · enrichment: receipt scans · tone: plain */
  .transparency-page {
    max-width: 42rem;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: hsl(5 53% 32% / 0.08);
    border: 1px solid hsl(5 53% 32% / 0.25);
    text-decoration: none;
    color: hsl(5, 53%, 32%);
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .back-link:hover {
    background: hsl(5 53% 32% / 0.14);
  }

  .hero {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 2.75rem);
    line-height: 1.05;
    margin: 0;
  }

  .lede {
    margin: 0;
    max-width: 38rem;
    color: hsl(0, 0%, 28%);
    line-height: 1.6;
  }

  .lede a,
  .receipt-note a,
  .donate-line a,
  .ledger a {
    color: hsl(5, 53%, 32%);
    font-weight: 600;
  }

  .month {
    margin-bottom: 2.5rem;
  }

  h2 {
    font-size: 1.5rem;
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid hsl(5 53% 32% / 0.2);
  }

  h3 {
    font-size: 1.0625rem;
    margin: 1.75rem 0 0.625rem;
  }

  .summary {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .summary-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.875rem 1rem;
    border-radius: 0.75rem;
    border: 1px solid hsl(5 30% 88%);
    background: hsl(5 20% 98%);
  }

  .summary-net {
    border-color: hsl(5 53% 32% / 0.35);
  }

  .summary-label {
    font-size: 0.875rem;
    color: hsl(0, 0%, 35%);
  }

  .summary-value {
    font-size: 1.375rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .ledger {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ledger li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.625rem 0;
    border-bottom: 1px solid hsl(5 30% 90%);
    line-height: 1.5;
  }

  .ledger-what {
    color: hsl(0, 0%, 20%);
  }

  .ledger-amount {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .ledger-total {
    border-bottom: none;
  }

  .ledger-month {
    font-weight: 700;
    font-size: 0.875rem;
    padding-top: 0.875rem;
  }

  .ledger-intro {
    margin: 0 0 0.375rem;
    font-size: 0.875rem;
    color: hsl(0, 0%, 35%);
  }

  .recur {
    font-size: 0.8125rem;
    color: hsl(0, 0%, 42%);
  }

  .sublines {
    list-style: none;
    margin: 0.375rem 0 0;
    padding: 0;
    font-size: 0.875rem;
    color: hsl(0, 0%, 35%);
  }

  .sublines li {
    display: block;
    border-bottom: none;
    padding: 0.125rem 0;
  }

  .ledger-total .ledger-what,
  .ledger-total .ledger-amount {
    font-weight: 700;
  }

  .receipts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .receipts figure {
    margin: 0;
  }

  .receipts img {
    width: 100%;
    height: auto;
    border: 1px solid hsl(5 30% 88%);
    border-radius: 0.5rem;
    background: white;
  }

  .receipts figcaption {
    margin-top: 0.375rem;
    font-size: 0.875rem;
    color: hsl(0, 0%, 35%);
  }

  .receipt-note {
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
    color: hsl(0, 0%, 35%);
    line-height: 1.5;
  }

  .chart {
    margin: 1.25rem 0 0;
  }

  .chart svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .chart figcaption {
    font-size: 0.875rem;
    color: hsl(0, 0%, 35%);
    margin-bottom: 0.375rem;
  }

  .chart .tick {
    font-size: 11px;
    fill: hsl(0, 0%, 45%);
    font-family: inherit;
  }

  .chart .dlabel {
    font-size: 11px;
    font-weight: 600;
    fill: hsl(0, 0%, 25%);
    font-family: inherit;
  }

  .month p {
    margin: 0 0 0.75rem;
    color: hsl(0, 0%, 28%);
    line-height: 1.6;
  }

  .donate-line p {
    margin: 0;
    padding: 1rem 1.25rem;
    border-radius: 0.75rem;
    border: 1px solid hsl(5 30% 88%);
    background: hsl(5 20% 98%);
    color: hsl(0, 0%, 28%);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .back-link:focus-visible,
  .ledger a:focus-visible,
  .receipts a:focus-visible,
  .donate-line a:focus-visible {
    outline: 2px solid hsl(5, 53%, 32%);
    outline-offset: 2px;
  }

  @media (max-width: 540px) {
    .summary,
    .receipts {
      grid-template-columns: minmax(0, 1fr);
    }

    .ledger li {
      flex-direction: column;
      gap: 0.125rem;
    }
  }
</style>
