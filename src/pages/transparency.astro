---
export const prerender = true;
import Layout from "@layouts/Layout.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<Layout
  title="Transparency | Room TBA"
  description="Monthly money report for Room TBA and UPLB Tools: every donation in, every expense out, receipt-backed."
  canonicalPath="/transparency"
  showAppLoadingShell={false}
>
  <main class="transparency-page">
    <a href="/" class="back-link">
      <span aria-hidden="true">←</span> Back to Room TBA
    </a>

    <header class="hero">
      <p class="eyebrow">Where the money goes</p>
      <h1>Transparency report</h1>
      <p class="lede">
        Room TBA runs on student donations. Each month we publish every peso
        in and every peso out, backed by payment records and receipts. The
        split we aim for is the same 40/30/30 as
        <a href="/sponsors">sponsorships</a>; months this small go entirely to
        keeping the lights on.
      </p>
    </header>

    <section class="month" aria-labelledby="aug-2026">
      <h2 id="aug-2026">August 2026</h2>

      <div class="stat-row">
        <div class="stat">
          <span class="stat-label">Income</span>
          <span class="stat-value">₱1,790.35</span>
        </div>
        <div class="stat">
          <span class="stat-label">Expenses</span>
          <span class="stat-value">₱1,983</span>
        </div>
        <div class="stat stat-net">
          <span class="stat-label">Net</span>
          <span class="stat-value">−₱193</span>
        </div>
      </div>

      <h3>Income</h3>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">What</th>
              <th scope="col">Evidence</th>
              <th scope="col" class="num">Amount</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>13 donations via <a href="/donate">/donate</a> (Aug 3–9), net of processor fees</td>
              <td>PayMongo payment records</td>
              <td class="num">₱1,290.35</td>
            </tr>
            <tr>
              <td>1 direct GCash donation</td>
              <td>Self-reported by the maintainer</td>
              <td class="num">₱500.00</td>
            </tr>
            <tr class="total">
              <td colspan="2">Total income</td>
              <td class="num">₱1,790.35</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h3>Expenses</h3>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">What</th>
              <th scope="col">Evidence</th>
              <th scope="col" class="num">Amount</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Vercel Pro hosting, first paid month (Jul 21)</td>
              <td>Vercel invoice, paid</td>
              <td class="num">$20.00 · ~₱1,140</td>
            </tr>
            <tr>
              <td>uplb.tools domain, 1 year (Jul 13)</td>
              <td>Porkbun invoice #10981073</td>
              <td class="num">$9.78 · ~₱558</td>
            </tr>
            <tr>
              <td>opencode AI credits for maintenance tooling (Aug 10)</td>
              <td>opencode.ai payment record</td>
              <td class="num">$5.00 · ~₱285</td>
            </tr>
            <tr class="total">
              <td colspan="2">Total expenses</td>
              <td class="num">~₱1,983</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="notes">
        <h3>Notes and method</h3>
        <ul>
          <li>
            Donations almost exactly covered the stack this month; the
            maintainers absorbed the ~₱193 gap.
          </li>
          <li>
            All 13 PayMongo donations arrived Aug 3–9 (enlistment week) and
            none after. Donations track term traffic.
          </li>
          <li>
            USD expenses are converted at ~₱57/USD, the approximate card rate
            at time of payment; peso figures for USD items are estimates.
          </li>
          <li>
            July-dated purchases (domain, first Vercel month) are counted here
            because this is the first report; future reports count expenses in
            the month they are charged.
          </li>
          <li>
            No contributor payouts this month: income below the operating
            floor, so 100% went to operations.
          </li>
        </ul>
      </div>
    </section>

    <section class="cta-card">
      <p>
        Every peso is accounted for. If Room TBA saved you a walk to the wrong
        building, consider covering next month's gap.
      </p>
      <a class="cta" href="/donate">Donate</a>
    </section>

    <SiteFooter />
  </main>
</Layout>

<style>
  /* Hallmark · macrostructure: Stat-Led document · theme: house (Raleway · maroon · light paper) · enrichment: none · tone: utilitarian-honest */
  .transparency-page {
    max-width: 42rem;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: hsl(5 53% 32% / 0.08);
    border: 1px solid hsl(5 53% 32% / 0.25);
    text-decoration: none;
    color: hsl(5, 53%, 32%);
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .back-link:hover {
    background: hsl(5 53% 32% / 0.14);
  }

  .hero {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    color: hsl(0, 0%, 40%);
    margin: 0;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 2.75rem);
    line-height: 1.05;
    margin: 0;
  }

  .lede {
    margin: 0;
    max-width: 38rem;
    color: hsl(0, 0%, 28%);
    line-height: 1.6;
  }

  .lede a {
    color: hsl(5, 53%, 32%);
    font-weight: 600;
  }

  .month {
    margin-bottom: 2.5rem;
  }

  h2 {
    font-size: 1.5rem;
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid hsl(5 53% 32% / 0.2);
  }

  h3 {
    font-size: 1.0625rem;
    margin: 1.75rem 0 0.625rem;
  }

  .stat-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.875rem 1rem;
    border-radius: 0.75rem;
    border: 1px solid hsl(5 30% 88%);
    background: hsl(5 20% 98%);
  }

  .stat-net {
    border-color: hsl(5 53% 32% / 0.35);
  }

  .stat-label {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.6875rem;
    color: hsl(0, 0%, 40%);
  }

  .stat-value {
    font-size: 1.375rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  th,
  td {
    text-align: left;
    padding: 0.5rem 0.625rem;
    border-bottom: 1px solid hsl(5 30% 90%);
    vertical-align: top;
    line-height: 1.5;
  }

  th {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.6875rem;
    color: hsl(0, 0%, 40%);
  }

  td a {
    color: hsl(5, 53%, 32%);
    font-weight: 600;
  }

  .num {
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  tr.total td {
    font-weight: 700;
    border-bottom: none;
  }

  .notes ul {
    margin: 0;
    padding-left: 1.125rem;
    color: hsl(0, 0%, 28%);
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cta-card {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 1.25rem;
    border-radius: 0.75rem;
    border: 1px solid hsl(5 30% 88%);
    background: hsl(5 20% 98%);
    margin-bottom: 2rem;
  }

  .cta-card p {
    margin: 0;
    color: hsl(0, 0%, 28%);
    line-height: 1.6;
  }

  .cta {
    align-self: flex-start;
    padding: 0.625rem 1.5rem;
    border-radius: 999px;
    background: hsl(5, 53%, 32%);
    color: white;
    font-weight: 700;
    text-decoration: none;
  }

  .cta:hover {
    background: hsl(5, 53%, 26%);
  }

  .cta:focus-visible,
  .back-link:focus-visible {
    outline: 2px solid hsl(5, 53%, 32%);
    outline-offset: 2px;
  }

  @media (max-width: 480px) {
    .stat-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
